APP_NAME=ai_makeup_recommender
APP_ENV=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/makeupdb
REDIS_URL=redis://redis:6379/0
MODEL_DIR=/app/artifacts
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=http://localhost:5173
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Set to use Anthropic Claude instead of Ollama for the beauty chatbot
ANTHROPIC_API_KEY=
# Path to PyTorch model checkpoint (leave empty to use rule-based baseline)
ML_CHECKPOINT_PATH=/app/artifacts/skin_tone_model.pt
VITE_API_BASE_URL=http://localhost:8000
